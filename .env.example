# .env.example -> isay copy karke ".env" naam se save karein (zaroori nahi, sirf tab jab chahiye)

# Chatbot ke liye (https://openrouter.ai se key milti hai). Bina key ke baqi app chalti hai.
OPENROUTER_API_KEY=

# Default SQLite hai (pharmacy.db). PostgreSQL chahiye to yeh line khol dein:
# DATABASE_URL=postgresql://pharmacy_user:apna_password@localhost:5432/pharmacy_db
# (Postgres ke liye requirements.txt mein psycopg2-binary ki line bhi khol dein)
